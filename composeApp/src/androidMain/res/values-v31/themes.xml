        <item name="android:windowSplashScreenBackground">@color/lilo_launch_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/lilo_launch_logo_system</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
